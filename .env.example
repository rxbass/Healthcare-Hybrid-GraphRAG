# Copy to .env and fill in. `.env` is git-ignored — never commit real values.

# --- OpenAI (embeddings + LLM) ---
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini            # generation (online) + triplet extraction (offline)
JUDGE_MODEL=gpt-4o               # Stage 2 eval judge — MUST differ from LLM_MODEL

# --- Neo4j Aura (graph + vector index) ---
# From the Aura console: neo4j+s://<dbid>.databases.neo4j.io
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j             # Aura: use the value from the downloaded credentials file (often the instance id)

# --- Ingestion ---
OPENFDA_BASE_URL=https://api.fda.gov/drug/label.json
# openFDA API key is optional (raises rate limit); leave blank to go keyless
OPENFDA_API_KEY=

# --- Observability ---
LOG_DIR=logs
